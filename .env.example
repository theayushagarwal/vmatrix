# Groq API Configuration (Used for Stage 3 ultra-fast semantic classification)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Supabase Database Configuration (Post history, vector memory, analytics)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_service_key

# Gemini API Key (Required for structured JSON carousel/infographic generation & embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Configuration (Required for public HTTPS image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Meta / Instagram Graph API Configuration (Required for automated carousel publishing)
IG_USER_ID=your_instagram_user_id
IG_USERNAME=vmatrix.co
IG_ACCESS_TOKEN=your_meta_graph_api_access_token

# Logo & Icon Providers
LOGODEV_SECRET_KEY=your_logodev_secret_key
LOGODEV_PUBLISHABLE_KEY=your_logodev_publishable_key
BRANDFETCH_API_KEY=your_brandfetch_api_key

# Cerebras Secondary Brain Failover (Tier 2)
CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_MODEL=llama-3.3-70b

# Nvidia NIM Visual Composition & Layout Audit (Tier 4)
NVIDIA_API_KEY=your_nvidia_nim_api_key
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# GitHub Models API (GPT-4o Vision Inspector)
GITHUB_TOKEN=your_github_token_for_models_api
GITHUB_VISION_MODEL=gpt-4o

# Apify Web Scraping & Deep Radar Intelligence
APIFY_API_KEY=your_apify_api_key

# Hugging Face API Configuration
HUGGINGFACE_API_KEY=your_huggingface_token
HF_TOKEN=your_huggingface_token

# OpenRouter API (High-Precision Deep Virality & Hook/Caption Intelligence)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

