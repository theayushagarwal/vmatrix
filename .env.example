# Groq API Configuration (Used for Stage 3 ultra-fast semantic classification)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Gemini API Key (Required for structured JSON carousel/infographic generation & embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Configuration (Required for public HTTPS image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Meta / Instagram Graph API Configuration (Required for automated carousel publishing)
IG_USER_ID=your_instagram_user_id
IG_ACCESS_TOKEN=your_meta_graph_api_access_token
